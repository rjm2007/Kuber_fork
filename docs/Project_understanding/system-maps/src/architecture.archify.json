  "cards": [
    {
      "dot": "cyan",
      "title": "The one idea to hold on to",
      "items": [
        "Nothing stays alive between requests",
        "Long jobs are chopped into batches that call the next batch",
        "The database is the queue, the lock table and the clock"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two API surfaces, three doors",
      "items": [
        "/api/v1/** — a person with a JWT, limited 300/120/20 per minute",
        "/api/enrich + /api/internal — workers and cron, shared secret",
        "Internal traffic never reaches requireAuth, so limits cannot throttle it"
      ]
    },
    {
      "dot": "rose",
      "title": "Where the money goes",
      "items": [
        "Apollo: search is free, revealing a contact costs a credit",
        "Firecrawl: bills for reaching a site, not for useful content",
        "Every LLM call writes tokens and cost to llm_usage",
        "Unknown model pricing records NULL, never 0"
      ]
    }
  ]
