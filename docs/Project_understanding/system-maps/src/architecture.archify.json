  "meta": {
    "title": "Kuber — What Runs Under the Hood",
    "output": "kuber-architecture.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "request-path",
        "label": "A person clicks something",
        "focus": [
          "users",
          "guard",
          "api",
          "db"
        ],
        "note": "Every browser call carries a JWT, passes the auth and rate-limit guard, and reaches Postgres already scoped to one company."
      },
      {
        "id": "long-jobs",
        "label": "Work longer than 55 seconds",
        "focus": [
          "api",
          "workers",
          "llm"
        ],
        "note": "A serverless function dies at 55s. A worker does about ten items, then calls its own URL for the next ten. No queue service."
      },
      {
        "id": "the-clock",
        "label": "The database is the scheduler",
        "focus": [
          "cron",
          "workers",
          "db"
        ],
        "note": "pg_cron fires eight jobs and pg_net POSTs back into the app. The clock lives in Postgres, not in Vercel."
      },
      {
        "id": "money",
        "label": "Everything that costs money",
        "focus": [
          "workers",
          "llm",
          "leaddata",
          "vault"
        ],
        "note": "Apollo credits, Firecrawl credits, LLM tokens. Every LLM call writes a row to llm_usage. Keys are vault rows, never env vars."
      },
      {
        "id": "mail-loop",
        "label": "Mail out, replies back",
        "focus": [
          "api",
          "instantly",
          "db"
        ],
        "note": "Drafts go to Instantly as custom variables and render at SEND time, not queue time. A webhook reports every send and reply."
      }
    ]
  },
